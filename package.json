{
  "name": "nonspace",
  "version": "0.0.0",
  "private": true,
  "description": "NONSPACE: a browser WebGL2 game set in the cyberspace of Neuromancer.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run convert:persona && npm run typecheck && vite build && node scripts/check-size.mjs",
    "convert:persona": "node scripts/convert-persona.mjs && prettier --write src/ai/personaPaths.ts",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "build:ink": "node scripts/build-ink.mjs"
  },
  "dependencies": {
    "three": "0.186.1",
    "tweakpane": "4.0.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tweakpane/core": "2.0.5",
    "@types/node": "22.19.1",
    "@types/pngjs": "6.0.5",
    "@types/three": "0.186.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-glsl": "1.6.2",
    "vitest": "5.0.5"
  }
}
